# ===========================================================================
# [SPEC] Project environment variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# ===========================================================================

# Memory Layer — pgvector (only if using shared backend)
# PGVECTOR_PASSWORD=your-secure-password

# Embedding — cloud providers (only if NOT using local model)
# OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=pa-...

# Jira — optional, enables Phase 3 of context-legacy skill
# Get API token at: id.atlassian.com/manage-profile/security/api-tokens
# JIRA_BASE_URL=https://your-company.atlassian.net
# JIRA_EMAIL=your@email.com
# JIRA_API_TOKEN=your-api-token
# JIRA_PROJECT_KEY=PROJ

# [SPEC] Add your project env vars below
# DATABASE_URL=postgresql://user:pass@localhost:5432/mydb
# SECRET_KEY=your-secret-key
# API_KEY=your-api-key
